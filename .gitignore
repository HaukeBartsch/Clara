# macOS AppleDouble metadata
._*

# secrets — never committed (REQ-CFG-001)
.env

# development database (REQ-CFG-009: per-developer SQLite file)
data/
# ...but the generated relevance Sankey structure ships with the web app
# (REQ-UI-059): production carries only bin/, web/ and .env, so this committed
# artifact is the only place the classification data reaches the browser.
!web/app/data/
/web/app/data/*
!/web/app/data/relevance_sankey.php
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# built API binary (Technology_Stack_Design.md §5)
api-server

# PHP session storage (REQ-CFG-017)
web/sessions/

# Playwright browser tests — development and CI tooling only, never served (REQ-TECH-028)
e2e/node_modules/
e2e/test-results/

# presentation generator (docs/intro-to-Clara/tools) — documentation tooling only
docs/intro-to-Clara/tools/node_modules/
e2e/playwright-report/
