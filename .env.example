# core
APP_ENV=development
API_ADDR=127.0.0.1:8080
# production refuses to start on an address other hosts can reach unless this names the exception:
# the internal service token plus the actor header is the whole credential for every account, so
# who can reach the port decides who can use it (System_Configuration_Design.md §4.1, REQ-CFG-033).
# Set it only behind mTLS or on a network you control end to end; ignored when APP_ENV=development.
#API_ALLOW_REMOTE=0
WEB_PUBLIC_URL=http://localhost:8000
LOG_LEVEL_API=debug
LOG_LEVEL_WEB=debug

# database (sqlite) — or DB_CONNECTION=mariadb with DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD
DB_CONNECTION=sqlite
DB_DATABASE=./data/app.sqlite

# service boundary — the development default is refused when APP_ENV=production, and so is
# anything under 32 bytes; `openssl rand -hex 32` issues one (INSTALL.md §6)
INTERNAL_SERVICE_TOKEN=dev-internal-token
ADMIN_BOOTSTRAP_EMAIL=admin@example.org
# required at startup when NO OAuth2 provider and NO LDAP server are configured (GD-18)
ADMIN_BOOTSTRAP_PASSWORD=***

# OAuth2 provider 1 (optional — table-based authentication is always available, GD-18)
OAUTH2_1_ISSUER=https://idp.example.org
OAUTH2_1_CLIENT_ID=csms
OAUTH2_1_CLIENT_SECRET=***
OAUTH2_1_REDIRECT_URI=http://localhost:8000/auth/callback
OAUTH2_1_EMAIL_ATTR=email
# comma-separated display names on the login page; unset → implicit default set (REQ-CFG-032)
OAUTH2_1_NAMES=Hospital 1
# Subject claim (default `sub`): the claim naming the provider's stable id for the person. Its
# value is stored verbatim with the account and preferred over the address on every later
# login, so an address changed at the provider cannot move the account to someone else
# (REQ-AUTH-080). Choose it before the first OAuth2 login: changing it later orphans every
# stored link. An empty value is refused at startup.
#OAUTH2_1_SUBJECT_ATTR=sub
# Address attestation (default 1): a login is refused unless the response that supplies the
# address also carries `email_verified` as the JSON boolean true — a string "true" does not
# count (REQ-AUTH-078). Set 0 only for a provider that cannot attest addresses at all, and
# record that in the installation notes. Write 0 or 1; a value that is not a boolean is
# ignored and the default 1 applies.
#OAUTH2_1_REQUIRE_EMAIL_VERIFIED=1
# Assurance gate (default empty = no gate): comma-separated values the ID token's `acr` must
# match, or one of which its `amr` must contain. With a gate set, a token carrying neither
# claim is refused (REQ-AUTH-081). OAuth2 logins skip CLARA's own second factor (REQ-AUTH-055),
# so this is how an installation makes the provider prove a multi-factor login.
#OAUTH2_1_MIN_ACR=
# Signing algorithm (default RS256): the one algorithm the ID token must be signed with; a
# token signed any other way is refused. Accepted: RS256/384/512, PS256/384/512,
# ES256/384/512, EdDSA (case-insensitive). `none` and the HMAC family (HS256…) are refused at
# startup, since they would verify nothing (REQ-AUTH-077).
#OAUTH2_1_ID_TOKEN_ALG=RS256
# Nonce (default 0): a token that carries a `nonce` must always match the one CLARA sent for
# this login. With 1, a token without a nonce is refused as well. Not every provider echoes
# the nonce, so 0 means "not yet observed", not "satisfied" — set 1 once a live login shows
# the provider returning it (REQ-AUTH-079). Write 0 or 1.
#OAUTH2_1_NONCE_REQUIRED=0

# OAuth2 provider 2 (optional) — example: Google identity (Workspace or Gmail accounts).
# In Google Cloud Console → APIs & Services → Credentials create an "OAuth client ID" of
# type "Web application"; the client ID ends in .apps.googleusercontent.com and pairs with
# the client secret shown there. Endpoints (authorize/token/userinfo) are discovered from
# the issuer — give it without a trailing slash. Under "Authorized redirect URIs" register
# OAUTH2_2_REDIRECT_URI exactly, character for character (http://localhost is allowed for
# development; use https in production). Google returns the address as "email" in its
# userinfo response — the default OAUTH2_2_EMAIL_ATTR=email applies; that claim is only
# present when the login requests the standard OIDC scopes (openid email).
#OAUTH2_2_ISSUER=https://accounts.google.com
#OAUTH2_2_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
#OAUTH2_2_CLIENT_SECRET=***
#OAUTH2_2_REDIRECT_URI=http://localhost:8000/auth/callback
#OAUTH2_2_EMAIL_ATTR=email
#OAUTH2_2_NAMES=Google

# OAuth2 provider 3 (optional) — example: PingFederate (OpenID Connect).
# PingFederate is configured exactly like any OIDC provider; there is no special mode.
# Two behaviors are written for it in particular:
#  - the authorize/token/userinfo endpoints come from the provider's own discovery
#    document, never derived from the issuer — PingFederate serves /as/authorization.oauth2,
#    /as/token.oauth2 and /idp/userinfo.openid, so a guessed path only yields a misleading
#    upstream error (REQ-AUTH-082); and
#  - a "split claim release" is a working deployment, not a broken one: PingFederate sets
#    the ID-token claims and /idp/userinfo.openid independently, so releasing the address
#    to userinfo only (with email_verified) is fine — the API asks the ID token first, then
#    the userinfo endpoint named by discovery (REQ-AUTH-078).
#
# OAUTH2_3_ISSUER is PingFederate's OIDC issuer. The API fetches
# <issuer>/.well-known/openid-configuration and requires that document's own `issuer` to
# equal this value, so copy it from the discovery document rather than typing a root.
# In PingFederate, create an OIDC client, set its redirect URI to OAUTH2_3_REDIRECT_URI
# exactly (character for character), and release: the address under OAUTH2_3_EMAIL_ATTR,
# `email_verified`, and the stable subject under OAUTH2_3_SUBJECT_ATTR (default `sub`).
#
# Leave NONCE_REQUIRED at 0: PingFederate's OIDC policy exposes no nonce option, and 0
# means "not yet observed", not "satisfied" (REQ-AUTH-079) — set 1 only after a live
# exchange is seen echoing a nonce. ID_TOKEN_ALG defaults to RS256; name a different
# asymmetric algorithm here if PingFederate signs with one (RS/PS/ES/EdDSA only — `none`
# and the HMAC family are refused, REQ-AUTH-077).
#
# Needs PingFederate 11.3 or newer; RP-initiated logout needs 12.0. Back-channel logout
# (single sign-out) is not yet implemented on the CLARA side.
#
#OAUTH2_3_ISSUER=https://idp.example.org/idp
#OAUTH2_3_CLIENT_ID=clara
#OAUTH2_3_CLIENT_SECRET=***
#OAUTH2_3_REDIRECT_URI=http://localhost:8000/auth/callback
#OAUTH2_3_EMAIL_ATTR=email
#OAUTH2_3_NAMES=Hospital 3
#OAUTH2_3_NONCE_REQUIRED=0

# shared by all OAuth2 providers: how many seconds a fetched provider signing-key set (JWKS)
# is reused before a scheduled refetch (default 3600). A token signed with an unknown key id
# refetches at once whatever this says, so a key rotation at the provider needs no restart.
# Must be a positive integer — 0 is refused at startup, since it would mean "never refetch"
# (REQ-CFG-035, REQ-AUTH-077).
#OAUTH2_JWKS_TTL=3600

# LDAP server 1 (optional — tried in parallel with the other sources under its name, §2.9)
#LDAP_SERVER_1_URL=ldap://dir.example.org:389
#LDAP_SERVER_1_SEARCH_BASE=ou=people,dc=example,dc=org
#LDAP_SERVER_1_UID_ATTR=uid
#LDAP_SERVER_1_EMAIL_ATTR=mail
#LDAP_SERVER_1_NAME_ATTR=cn
#LDAP_SERVER_1_NAMES=Hospital 2

# names the table-based (local) source is selected by on the login page
#LOCAL_LOGIN_NAMES=Clinic A

# anonymization
ANON_SALT=dev-a…n-salt
ANON_DATE_SHIFT_MIN=0
ANON_DATE_SHIFT_MAX=364

# data validation
#MAX_VALUE_BYTES=1048576

# sessions (web)
SESSION_DIR=/tmp/csms-sessions
# sent as __Host-csms_session whenever SESSION_COOKIE_SECURE=1
SESSION_COOKIE_NAME=csms_session
# absolute lifetime from sign-in, in seconds
SESSION_LIFETIME=28800
# sign out after this many seconds without a request; 0 = off
SESSION_IDLE_TIMEOUT=1800
# replace the session id this often (seconds, 0 or >= 120); 0 also turns off replay detection
SESSION_ROTATE_INTERVAL=900
# must be 1 when APP_ENV=production
SESSION_COOKIE_SECURE=0

# rate limiting (api, web) — thresholds live in system_settings, edited in the admin interface;
# both components take a forwarded X-Real-IP only from these addresses and use the connection
# address otherwise, so a browser cannot name itself
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1

# account policy and time (api)
AUTH_INACTIVITY_LIMIT_DAYS=180
# lifetime of the single-use invite / password-reset links (GD-22/GD-23)
AUTH_PASSWORD_TOKEN_TTL_DAYS=7
APP_TIMEZONE=UTC

# appearance (web) — installation default theme: bootstrap | darkly | yeti (GD-26);
# users may override it personally; an unknown value refuses startup
UI_THEME=bootstrap

# monitoring charts (web) — how far back the Control Panel's Monitoring charts reach, in minutes
# (REQ-CFG-034): the page samples once a second while it is visible and drops every timepoint older
# than this period, so an open tab carries one period of history and no more.
# 1…1440; anything else refuses startup. Default: 10
MONITORING_PERIOD_MINUTES=10

# two-factor authentication (api) — local and LDAP logins only; opt-in per
# user unless AUTH_REQUIRE_2FA mandates it installation-wide
AUTH_REQUIRE_2FA=0
TOTP_ISSUER=CLARA
TFA_EMAIL_CODE_TTL=600
# email second factor needs an SMTP relay; OTP_MAIL_FROM is required when
# SMTP_HOST is set
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_SECURITY=starttls   # starttls | tls | none
#SMTP_USERNAME=
#SMTP_PASSWORD=
#OTP_MAIL_FROM=codes@example.org
